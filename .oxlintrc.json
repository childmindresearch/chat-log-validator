{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [],
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-floating-promises": "off",
    "no-unused-vars": [
      "warn",
      {
        "caughtErrors": "none",
        "argsIgnorePattern": "^_"
      }
    ]
  }
}
